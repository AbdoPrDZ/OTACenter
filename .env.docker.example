# ---------------------------------------------------------------------------
# OTACenter — Docker environment template
#
#   cp .env.docker.example .env.docker
#
# Compose reads this file twice:
#   1. it is passed to every PHP container as `env_file`, and
#   2. Compose itself interpolates ${...} from it (APP_PORT, the DB credentials).
#
# Values hard-coded in docker-compose.yml's `environment:` block (APP_ENV,
# APP_DEBUG, LOG_CHANNEL, DB_CONNECTION, DB_HOST, SESSION_DRIVER, CACHE_STORE,
# QUEUE_CONNECTION, RUN_MIGRATIONS) always win over this file — change them
# there, not here.
# ---------------------------------------------------------------------------

# --- Host ------------------------------------------------------------------
# Host port published to the app container's port 80.
APP_PORT=8000

# --- Application -----------------------------------------------------------
APP_NAME=OTACenter
# Public base URL that users and devices reach. No trailing slash. When
# OTACenter sits behind a TLS proxy this must be the https:// URL.
APP_URL=http://localhost:8000
# Left empty on purpose: the entrypoint runs `php artisan key:generate` on first
# boot. Set an explicit key to keep sessions and encrypted cookies stable across
# rebuilds, e.g. php artisan key:generate --show
APP_KEY=
# Required once, by `php artisan db:seed` (SuperAdminSeeder).
APP_SUPER_ADMIN_LOGIN=superadmin
APP_SUPER_ADMIN_PASSWORD=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# --- Database --------------------------------------------------------------
# These credentials configure BOTH the Laravel app and the bundled Postgres
# service. DB_CONNECTION and DB_HOST are fixed by docker-compose.yml
# (pgsql on the `db` service); point at an external server in the compose file
# if you do not want to run the bundled database.
DB_DATABASE=otacenter
DB_USERNAME=otacenter
DB_PASSWORD=secret

# --- LDAP ------------------------------------------------------------------
# The app authenticates against your directory, so these are required in
# practice. To reach a server on the Docker host use `host.docker.internal`
# (on Linux add: extra_hosts: ["host.docker.internal:host-gateway"]).
LDAP_CONNECTION=default
LDAP_HOST=host.docker.internal
LDAP_PORT=389
LDAP_BASE_DN=dc=local,dc=com
LDAP_USERNAME=cn=user,dc=local,dc=com
LDAP_PASSWORD=
LDAP_TIMEOUT=5
LDAP_TLS=false
LDAP_STARTTLS=false
LDAP_SASL=false
LDAP_LOGIN_SUFFIX=
LDAP_LOGGING=false
LDAP_CACHE=false

# --- Files & runtime -------------------------------------------------------
# Uploads (APKs, bundles, logos, screenshots) land on the otacenter-storage
# volume mounted at /var/www/html/storage.
FILESYSTEM_DISK=public

# --- Optional: outbound mail ----------------------------------------------
# Used for registration invites. Uncomment and fill in to send real mail.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=ota@example.com
# MAIL_FROM_NAME=OTACenter
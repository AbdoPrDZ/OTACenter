# Build context excludes
.git
.github
.opencode
node_modules
vendor
public/build
public/hot
public/storage
storage/*.key
storage/pail
# Uploaded artifacts (APKs, bundles, logos, screenshots) are runtime data and
# must never be baked into an image — they arrive on the storage volume.
storage/app
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.env
.env.*
!.env.example
!.env.docker.example
OTACenter.rar
.agents
_ide_helper.php
*.log
.phpunit.result.cache
docker-compose.yml
docker-compose.*.yml
